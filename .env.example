# Copy to .env and adjust:  cp .env.example .env
# .env is gitignored and holds real values. This file is committed — placeholders only.
#
# Consumed by:
#   app/config.py        -> APP_ENV, DATABASE_URL, REDIS_URL
#   docker-compose.yml   -> POSTGRES_*, *_PORT

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=local

# Host differs by where the app runs:
#   uvicorn on your machine   -> localhost
#   inside a compose service  -> db / redis  (the compose service names)
# The credentials and port here must match the POSTGRES_* values below.
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# ── Postgres container ─────────────────────────────────────────────────────
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# ── Published host ports ───────────────────────────────────────────────────
# Change if something already occupies these locally (a system Postgres on
# 5432 is common). The container-side ports never change; only the host side.
POSTGRES_PORT=5432
REDIS_PORT=6379

OPENAI_API_KEY=sk-...your-key-here...